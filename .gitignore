# Ignore all files in output and subfolders
/output/**

# But keep .gitkeep files so directory structure is tracked
!/output/.gitkeep
!/output/**/.gitkeep

# macOS and R ignores
.DS_Store
.Rhistory
.Rproj.user/

# Ignore all files in outputs and subfolders
/outputs/**

# But keep .gitkeep files so directory structure is tracked
!/outputs/.gitkeep
!/outputs/**/.gitkeep

# Ignore output contents but keep placeholders
